<% layout('/layouts/boilerplate') -%>
<body>
    <h3>all listings</h3>

    <div class="listing-photos">
  <% for(let listing of allListings){%>
    <a class="listing-link" href="/listings/<%= listing._id%>">
    <div class="cards" style="width: 18rem;">
  <div class="card-body">
    <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem;">
    <h5 class="title"><%= listing.title %></h5>
    <div class="price">&#8377; <%= listing.price.toLocaleString("en-IN") %>/Night</div>
    <p class="description"><%= listing.description %> </p>
    <div class="location"><%= listing.location %></div>
  </div>
</div>
</a>
 <%}%>
</div>
</div>

     <form methord ="GET" action="/listings/new">
        <button>create new listings</button>
    </form>